{
  "version": 8,
  "name": "Euskadi oscuro",
  "metadata": {
    "descripcion": "Estilo oscuro para MapLibre GL. Teselas vectoriales de OpenFreeMap (esquema OpenMapTiles, datos OpenStreetMap). Las rutas data/*.geojson son relativas a la página que carga el estilo.",
    "licencia": "MIT (estilo). Datos © colaboradores de OpenStreetMap (ODbL)."
  },
  "center": [-2.62, 43.04],
  "zoom": 8.6,
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\">OpenFreeMap</a> · <a href=\"https://www.openmaptiles.org/\" target=\"_blank\">© OpenMapTiles</a> · <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">© OpenStreetMap</a>"
    },
    "mascara": { "type": "geojson", "data": "data/mascara.geojson" },
    "euskadi": { "type": "geojson", "data": "data/euskadi.geojson" },
    "provincias": { "type": "geojson", "data": "data/provincias.geojson" },
    "municipios": { "type": "geojson", "data": "data/municipios.geojson" }
  },
  "layers": [
    { "id": "fondo", "type": "background", "paint": { "background-color": "#1a1d23" } },

    { "id": "uso-residencial", "type": "fill", "source": "osm", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["residential", "suburb", "neighbourhood", "commercial", "retail"]]],
      "paint": { "fill-color": "#20242b", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.4, 13, 1] } },
    { "id": "uso-industrial", "type": "fill", "source": "osm", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["industrial", "railway", "quarry"]]],
      "paint": { "fill-color": "#1d1d22" } },
    { "id": "bosque", "type": "fill", "source": "osm", "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["wood", "forest"]]],
      "paint": { "fill-color": "#17201c", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0.6, 12, 0.9] } },
    { "id": "prado", "type": "fill", "source": "osm", "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["grass", "farmland", "wetland"]]],
      "paint": { "fill-color": "#191d1b", "fill-opacity": 0.7 } },
    { "id": "arena", "type": "fill", "source": "osm", "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "sand"],
      "paint": { "fill-color": "#24231f" } },
    { "id": "parques", "type": "fill", "source": "osm", "source-layer": "park",
      "paint": { "fill-color": "#18241f", "fill-opacity": 0.8 } },
    { "id": "uso-verde", "type": "fill", "source": "osm", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["park", "cemetery", "pitch", "stadium", "garden", "playground"]]],
      "paint": { "fill-color": "#19251f" } },

    { "id": "agua", "type": "fill", "source": "osm", "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "fill-color": "#0c1724" } },
    { "id": "rios", "type": "line", "source": "osm", "source-layer": "waterway",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "line-color": "#11233a",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 8, 0.5, 14, 2, 18, 6] } },

    { "id": "aeropuerto", "type": "fill", "source": "osm", "source-layer": "aeroway",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": { "fill-color": "#1e2026" } },
    { "id": "pista", "type": "line", "source": "osm", "source-layer": "aeroway",
      "minzoom": 10, "filter": ["in", ["get", "class"], ["literal", ["runway", "taxiway"]]],
      "paint": { "line-color": "#2b2f37", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 10, 1, 16, 30] } },

    { "id": "edificios", "type": "fill", "source": "osm", "source-layer": "building", "minzoom": 13,
      "paint": { "fill-color": "#262a32", "fill-outline-color": "#323743",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14, 1] } },

    { "id": "tunel", "type": "line", "source": "osm", "source-layer": "transportation", "minzoom": 12,
      "filter": ["all", ["==", ["get", "brunnel"], "tunnel"], ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"]]]],
      "layout": { "line-cap": "butt", "line-join": "round" },
      "paint": { "line-color": "#2c3038", "line-dasharray": [1.5, 1.5],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 12, 0.6, 18, 8] } },

    { "id": "senderos", "type": "line", "source": "osm", "source-layer": "transportation", "minzoom": 14,
      "filter": ["all", ["!=", ["get", "brunnel"], "tunnel"], ["in", ["get", "class"], ["literal", ["path", "track"]]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#353a43", "line-dasharray": [2, 1.5],
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.6, 18, 1.6] } },
    { "id": "servicio", "type": "line", "source": "osm", "source-layer": "transportation", "minzoom": 14,
      "filter": ["all", ["!=", ["get", "brunnel"], "tunnel"], ["==", ["get", "class"], "service"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#2c3038",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 14, 0.6, 18, 6] } },
    { "id": "calles", "type": "line", "source": "osm", "source-layer": "transportation", "minzoom": 11,
      "filter": ["all", ["!=", ["get", "brunnel"], "tunnel"], ["==", ["get", "class"], "minor"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": ["interpolate", ["linear"], ["zoom"], 12, "#2a2e36", 16, "#3a3f4a"],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 11, 0.4, 14, 1.6, 16, 5, 18, 14, 20, 40] } },
    { "id": "carreteras-secundarias", "type": "line", "source": "osm", "source-layer": "transportation", "minzoom": 9,
      "filter": ["all", ["!=", ["get", "brunnel"], "tunnel"], ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": ["interpolate", ["linear"], ["zoom"], 9, "#2f333c", 14, "#4a505c"],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 9, 0.5, 13, 1.8, 16, 7, 18, 18, 20, 48] } },
    { "id": "carreteras-principales", "type": "line", "source": "osm", "source-layer": "transportation", "minzoom": 6,
      "filter": ["all", ["!=", ["get", "brunnel"], "tunnel"], ["in", ["get", "class"], ["literal", ["primary", "trunk"]]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": ["interpolate", ["linear"], ["zoom"], 7, "#3a3e47", 14, "#5d5a52"],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 6, 0.4, 10, 1.2, 14, 4, 16, 9, 18, 22, 20, 56] } },
    { "id": "autopistas", "type": "line", "source": "osm", "source-layer": "transportation", "minzoom": 5,
      "filter": ["all", ["!=", ["get", "brunnel"], "tunnel"], ["==", ["get", "class"], "motorway"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": ["interpolate", ["linear"], ["zoom"], 6, "#5b4a33", 12, "#8a6b40"],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 0.5, 10, 1.6, 14, 5, 16, 11, 18, 26, 20, 64] } },
    { "id": "ferrocarril", "type": "line", "source": "osm", "source-layer": "transportation", "minzoom": 9,
      "filter": ["all", ["!=", ["get", "brunnel"], "tunnel"], ["in", ["get", "class"], ["literal", ["rail", "transit"]]]],
      "paint": { "line-color": "#41444c",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 16, 1.6] } },
    { "id": "ferrocarril-traviesas", "type": "line", "source": "osm", "source-layer": "transportation", "minzoom": 13,
      "filter": ["all", ["!=", ["get", "brunnel"], "tunnel"], ["in", ["get", "class"], ["literal", ["rail", "transit"]]]],
      "paint": { "line-color": "#41444c", "line-dasharray": [0.2, 4],
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 3, 18, 8] } },

    { "id": "municipios-linea", "type": "line", "source": "municipios", "minzoom": 9,
      "paint": { "line-color": "#8f96a3", "line-opacity": ["interpolate", ["linear"], ["zoom"], 9, 0.15, 12, 0.3],
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.4, 14, 1], "line-dasharray": [3, 2] } },
    { "id": "provincias-linea", "type": "line", "source": "provincias",
      "paint": { "line-color": "#c9b07a", "line-opacity": 0.45,
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.6, 14, 1.6], "line-dasharray": [4, 2] } },

    { "id": "mascara", "type": "fill", "source": "mascara",
      "paint": { "fill-color": "#040508", "fill-opacity": 0.74, "fill-antialias": false } },

    { "id": "euskadi-halo", "type": "line", "source": "euskadi",
      "layout": { "line-join": "round" },
      "paint": { "line-color": "#e2bf7a", "line-opacity": 0.18, "line-blur": 6,
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 6, 14, 14] } },
    { "id": "euskadi-borde", "type": "line", "source": "euskadi",
      "layout": { "line-join": "round" },
      "paint": { "line-color": "#e8c987",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 14, 2] } },

    { "id": "nombres-agua", "type": "symbol", "source": "osm", "source-layer": "water_name",
      "filter": ["==", ["geometry-type"], "Point"],
      "metadata": { "etiqueta": true },
      "layout": { "text-field": ["coalesce", ["get", "name"], ""], "text-font": ["Noto Sans Italic"],
        "text-size": 12, "text-letter-spacing": 0.15, "text-max-width": 8 },
      "paint": { "text-color": "#4d6a8c", "text-halo-color": "#0c1724", "text-halo-width": 1 } },
    { "id": "nombres-rios", "type": "symbol", "source": "osm", "source-layer": "waterway", "minzoom": 12,
      "metadata": { "etiqueta": true },
      "layout": { "text-field": ["coalesce", ["get", "name"], ""], "text-font": ["Noto Sans Italic"],
        "symbol-placement": "line", "text-size": 11, "text-letter-spacing": 0.1 },
      "paint": { "text-color": "#4d6a8c", "text-halo-color": "#0c1724", "text-halo-width": 1 } },

    { "id": "nombres-calles", "type": "symbol", "source": "osm", "source-layer": "transportation_name", "minzoom": 14,
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "tertiary", "secondary", "primary", "trunk"]]],
      "metadata": { "etiqueta": true },
      "layout": { "text-field": ["coalesce", ["get", "name"], ""], "text-font": ["Noto Sans Regular"],
        "symbol-placement": "line", "text-max-angle": 30,
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 18, 14] },
      "paint": { "text-color": "#a7adb8", "text-halo-color": "#1a1d23", "text-halo-width": 1.4 } },
    { "id": "ref-carreteras", "type": "symbol", "source": "osm", "source-layer": "transportation_name", "minzoom": 9,
      "filter": ["all", ["has", "ref"], ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]]],
      "layout": { "text-field": ["get", "ref"], "text-font": ["Noto Sans Bold"], "text-size": 10,
        "symbol-placement": "line", "symbol-spacing": 400, "text-rotation-alignment": "viewport" },
      "paint": { "text-color": "#d8b679", "text-halo-color": "#1a1d23", "text-halo-width": 1.6 } },

    { "id": "poi", "type": "symbol", "source": "osm", "source-layer": "poi", "minzoom": 16,
      "filter": ["<=", ["get", "rank"], 20],
      "metadata": { "etiqueta": true },
      "layout": { "text-field": ["coalesce", ["get", "name"], ""], "text-font": ["Noto Sans Regular"],
        "text-size": 10, "text-max-width": 8 },
      "paint": { "text-color": "#7f8694", "text-halo-color": "#1a1d23", "text-halo-width": 1.2 } },
    { "id": "cumbres", "type": "symbol", "source": "osm", "source-layer": "mountain_peak", "minzoom": 11,
      "filter": ["has", "name"],
      "metadata": { "etiqueta": true },
      "layout": { "text-field": ["case", ["has", "ele"], ["concat", "▲ ", ["get", "name"], "\n", ["to-string", ["get", "ele"]], " m"], ["concat", "▲ ", ["get", "name"]]],
        "text-font": ["Noto Sans Regular"], "text-size": 10 },
      "paint": { "text-color": "#8a8f7d", "text-halo-color": "#1a1d23", "text-halo-width": 1.2 } },

    { "id": "barrios", "type": "symbol", "source": "osm", "source-layer": "place", "minzoom": 12,
      "filter": ["in", ["get", "class"], ["literal", ["suburb", "neighbourhood", "quarter", "hamlet", "isolated_dwelling", "locality"]]],
      "metadata": { "etiqueta": true },
      "layout": { "text-field": ["coalesce", ["get", "name"], ""], "text-font": ["Noto Sans Regular"],
        "text-transform": "uppercase", "text-letter-spacing": 0.12,
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 9, 16, 12], "text-max-width": 8 },
      "paint": { "text-color": "#8b919c", "text-halo-color": "#1a1d23", "text-halo-width": 1.2 } },
    { "id": "pueblos", "type": "symbol", "source": "osm", "source-layer": "place", "minzoom": 10,
      "filter": ["==", ["get", "class"], "village"],
      "metadata": { "etiqueta": true },
      "layout": { "text-field": ["coalesce", ["get", "name"], ""], "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 15, 14], "text-max-width": 8 },
      "paint": { "text-color": "#b4b9c2", "text-halo-color": "#1a1d23", "text-halo-width": 1.3 } },
    { "id": "villas", "type": "symbol", "source": "osm", "source-layer": "place", "minzoom": 8,
      "filter": ["==", ["get", "class"], "town"],
      "metadata": { "etiqueta": true },
      "layout": { "text-field": ["coalesce", ["get", "name"], ""], "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 14, 16], "text-max-width": 8 },
      "paint": { "text-color": "#d3d6dc", "text-halo-color": "#1a1d23", "text-halo-width": 1.4 } },
    { "id": "ciudades", "type": "symbol", "source": "osm", "source-layer": "place", "minzoom": 5,
      "filter": ["==", ["get", "class"], "city"],
      "metadata": { "etiqueta": true },
      "layout": { "text-field": ["coalesce", ["get", "name"], ""], "text-font": ["Noto Sans Bold"],
        "text-transform": "uppercase", "text-letter-spacing": 0.18,
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 18], "text-max-width": 8 },
      "paint": { "text-color": "#f0e6d2", "text-halo-color": "#111216", "text-halo-width": 1.6 } }
  ]
}
